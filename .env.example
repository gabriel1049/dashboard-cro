# Copie para .env e preencha. O .env nunca vai para o git.

# --- Propriedade -------------------------------------------------------------
# Propriedades do seletor do painel, no formato id=nome|fuso, separadas por ";".
# A primeira é a padrão; o fuso é opcional. Já vem com o Site e o App da Mycon.
GA4_PROPERTIES=314161581=Mycon | Site|America/Sao_Paulo;469824674=Mycon | App|America/Rio_Branco
# Alternativa para uma propriedade só (no lugar da linha acima). O ID fica em Administrador > Detalhes da propriedade.
# GA4_PROPERTY_ID=000000000
# GA4_PROPERTY_LABEL=Minha propriedade

# Fuso padrão (cada propriedade acima pode ter o seu). Define o que é "ontem".
GA4_TIME_ZONE=America/Sao_Paulo

# --- Termos de negócio -------------------------------------------------------
# Rótulos do valor do evento purchase e do valor médio por compra.
CRO_REVENUE_LABEL=Receita
CRO_TICKET_LABEL=Ticket médio
# Eventos que contam como erro na seção de tecnologia e telas (separados por vírgula)
CRO_ERROR_EVENTS=erro_sistema,app_exception
# Evento de lead para o seletor "Meta: Compra | Lead". O seletor só aparece se ele for evento-chave na propriedade.
CRO_LEAD_EVENT=generate_lead

# --- Autenticação (somente leitura: analytics.readonly) -----------------------
# auto            = usa a Service Account se encontrar a chave; senão, OAuth
# oauth           = login com a sua conta Google (basta acesso de Leitor na propriedade)
# service_account = conta de serviço (um Administrador precisa adicioná-la como Leitor)
GA4_AUTH_MODE=auto

# OAuth em desenvolvimento: arquivos gerados pelo login do laboratório Python (lab/)
GA4_OAUTH_CLIENT_FILE=credentials/client_secret.json
GA4_OAUTH_TOKEN_FILE=credentials/token.json
# Porta do login local. Cadastre http://localhost:<porta>/ como URI de redirecionamento do cliente Web.
GA4_OAUTH_PORT=8080

# OAuth em produção (servidor sem os arquivos acima): copie os três valores do credentials/token.json
# GA4_OAUTH_CLIENT_ID=
# GA4_OAUTH_CLIENT_SECRET=
# GA4_OAUTH_REFRESH_TOKEN=

# Transporte da API do GA4: deixe vazio (gRPC) ou use "rest" se a hospedagem bloquear o gRPC
# GA4_API_TRANSPORT=

# --- Acesso ao painel ----------------------------------------------------------
# Senha compartilhada da tela de login. Sem ela: em desenvolvimento o login fica desligado;
# em produção ninguém entra (a tela avisa que o acesso não foi configurado).
# DASHBOARD_PASSWORD=
# Chave que assina o cookie de sessão (trocar derruba todas as sessões). Opcional: sem ela, usa a senha.
# DASHBOARD_SECRET=

# Service Account: caminho do JSON ou o conteúdo (JSON puro ou em base64) em GA4_SERVICE_ACCOUNT_JSON
GA4_SERVICE_ACCOUNT_FILE=credentials/service_account.json
# GA4_SERVICE_ACCOUNT_JSON=
